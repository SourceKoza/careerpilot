# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

if [ -z "$MAVEN_WRAPPER_JAR" ]; then
    MAVEN_WRAPPER_JAR="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 && pwd )/.mvn/wrapper/maven-wrapper.jar"
fi

if [ -r "$MAVEN_WRAPPER_JAR" ]; then
    echo "Found maven-wrapper.jar, using it..."
    if [ -n "$JAVA_HOME" ]; then
        JAVA_CMD="$JAVA_HOME/bin/java"
    else
        JAVA_CMD="java"
    fi
    exec "$JAVA_CMD" \
        $MAVEN_OPTS \
        $MAVEN_DEBUG_OPTS \
        -jar "$MAVEN_WRAPPER_JAR" "$@"
fi

# Fall back to using mvn from PATH
echo "maven-wrapper.jar not found, falling back to mvn command..."
exec mvn "$@"
